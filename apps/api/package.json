{
  "name": "api",
  "private": true,
  "type": "module",
  "scripts": {
    "clean": "rimraf node_modules .turbo dist",
    "dev:watch": "tsdown ./src/main.ts --watch",
    "dev": "portless",
    "start": "node dist/main.mjs",
    "dev:app": "tsdown ./src/main.ts && node dist/main.mjs",
    "build": "tsdown"
  },
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@orpc/server": "catalog:orpc",
    "@repo/rpc": "workspace:*",
    "@repo/telemetry": "workspace:*",
    "fastify": "^5.8.5"
  },
  "devDependencies": {
    "@repo/tsconfig": "workspace:*",
    "tsdown": "^0.22.2",
    "typescript": "catalog:"
  },
  "packageManager": "pnpm@10.34.1",
  "portless": {
    "name": "local.api.peow",
    "script": "dev:app"
  }
}
