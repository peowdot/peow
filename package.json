{
  "name": "peow",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "clean": "turbo clean && rimraf node_modules .turbo .fallow",
    "dev": "turbo dev",
    "fmt": "oxfmt .",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "docker:clean": "docker compose down -v",
    "docker:down": "docker compose down",
    "docker:up": "docker compose up -d",
