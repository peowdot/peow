    "build": "turbo build",
    "prepare": "lefthook install",
    "fallow": "fallow"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "fallow": "^2.91.0",
    "lefthook": "^2.1.9",
    "oxfmt": "^0.54.0",
    "oxlint": "^1.69.0",
    "portless": "^0.14.0",
    "rimraf": "^6.1.3",
    "turbo": "^2.9.17",
    "typescript": "catalog:",
    "ultracite": "7.8.3",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.34.1"
}
